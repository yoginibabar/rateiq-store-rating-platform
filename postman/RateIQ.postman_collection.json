{
    "info": {
        "name": "RateIQ API",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "base",
            "value": "http://localhost:5000/api"
        },
        {
            "key": "token",
            "value": ""
        }
    ],
    "item": [
        {
            "name": "Health",
            "request": {
                "method": "GET",
                "url": "{{base}}/health"
            }
        },
        {
            "name": "Authentication",
            "item": [
                {
                    "name": "Register",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\"name\":\"Demo User\",\"email\":\"demo@rateiq.com\",\"address\":\"Pune, India\",\"password\":\"Demo@12345\",\"confirmPassword\":\"Demo@12345\"}"
                        },
                        "url": "{{base}}/auth/register"
                    }
                },
                {
                    "name": "Login",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\"email\":\"user1@rateiq.com\",\"password\":\"User@12345\"}"
                        },
                        "url": "{{base}}/auth/login"
                    }
                },
                {
                    "name": "Me",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": "{{base}}/auth/me"
                    }
                },
                {
                    "name": "Change Password",
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\"currentPassword\":\"User@12345\",\"newPassword\":\"NewUser@12345\",\"confirmPassword\":\"NewUser@12345\"}"
                        },
                        "url": "{{base}}/auth/password"
                    }
                }
            ]
        },
        {
            "name": "Stores",
            "item": [
                {
                    "name": "Explore",
                    "request": {
                        "method": "GET",
                        "url": "{{base}}/stores?sort=rating&q=Pune"
                    }
                },
                {
                    "name": "Details",
                    "request": {
                        "method": "GET",
                        "url": "{{base}}/stores/1"
                    }
                },
                {
                    "name": "Health",
                    "request": {
                        "method": "GET",
                        "url": "{{base}}/stores/1/health"
                    }
                },
                {
                    "name": "Trend",
                    "request": {
                        "method": "GET",
                        "url": "{{base}}/stores/1/trends"
                    }
                },
                {
                    "name": "Confidence",
                    "request": {
                        "method": "GET",
                        "url": "{{base}}/stores/1/confidence"
                    }
                }
            ]
        },
        {
            "name": "Ratings",
            "item": [
                {
                    "name": "Create or Update Rating",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\"storeId\":1,\"value\":5}"
                        },
                        "url": "{{base}}/ratings"
                    }
                },
                {
                    "name": "My Rating",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": "{{base}}/stores/1/my-rating"
                    }
                }
            ]
        },
        {
            "name": "Owner",
            "item": [
                {
                    "name": "Dashboard",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": "{{base}}/owner/dashboard"
                    }
                },
                {
                    "name": "Ratings",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": "{{base}}/owner/ratings"
                    }
                },
                {
                    "name": "Analytics",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": "{{base}}/owner/analytics"
                    }
                },
                {
                    "name": "Insights",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": "{{base}}/owner/insights"
                    }
                }
            ]
        },
        {
            "name": "Admin",
            "item": [
                {
                    "name": "Overview",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": "{{base}}/admin/overview"
                    }
                },
                {
                    "name": "Users",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": "{{base}}/admin/users"
                    }
                },
                {
                    "name": "Stores",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": "{{base}}/admin/stores"
                    }
                },
                {
                    "name": "Ratings",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": "{{base}}/admin/ratings"
                    }
                },
                {
                    "name": "Risk Center",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": "{{base}}/admin/risks"
                    }
                },
                {
                    "name": "Audit Logs",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": "{{base}}/audit-logs"
                    }
                },
                {
                    "name": "Reports - Users",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": "{{base}}/reports/users"
                    }
                },
                {
                    "name": "Reports - Stores",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": "{{base}}/reports/stores"
                    }
                },
                {
                    "name": "Reports - Ratings",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": "{{base}}/reports/ratings"
                    }
                }
            ]
        },
        {
            "name": "Notifications",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}"
                    }
                ],
                "url": "{{base}}/notifications"
            }
        }
    ]
}